rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidExperiment(data) {
      return data is map &&
        data.keys().hasAll(['name', 'createdAt', 'runtimeMs', 'status', 'config', 'solutions']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.runtimeMs is number &&
        data.status is string && (data.status == 'optimal' || data.status == 'feasible' || data.status == 'infeasible') &&
        data.config is map &&
        data.solutions is list && data.solutions.size() <= 10;
    }

    match /experiments/{experimentId} {
      // Allow reading experiments for benchmark comparison
      allow get, list: if true;

      // Allow creating and deleting test run documents
      allow create: if isValidId(experimentId) && isValidExperiment(request.resource.data);
      allow update: if isValidId(experimentId) && isValidExperiment(request.resource.data);
      allow delete: if isValidId(experimentId);
    }
  }
}
